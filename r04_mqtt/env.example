# Copiar este ficheiro para .env e preencher com os valores da consola TTS.
# NUNCA colocar a API Key real neste ficheiro de exemplo nem no GitHub.

# Host MQTT indicado em The Things Stack > Integrations > MQTT.
# Apenas o hostname, sem mqtt:// ou https://
MQTT_HOST=HOST_MQTT_INDICADO_PELO_TTS
MQTT_PORT=8883

# Username e API Key apresentados/gerados na integração MQTT.
# Em instalações multi-tenant, o username segue application_id@tenant_id.
MQTT_USERNAME=APPLICATION_ID@TENANT_ID
MQTT_PASSWORD=COLOCAR_API_KEY_APENAS_NO_FICHEIRO_LOCAL_ENV

# Tópico para todos os dispositivos da aplicação.
# Multi-tenant: v3/APPLICATION_ID@TENANT_ID/devices/+/up
# The Things Stack Open Source: v3/APPLICATION_ID/devices/+/up
MQTT_TOPIC=v3/APPLICATION_ID@TENANT_ID/devices/+/up

# Deve ser único para esta instância do consumidor.
MQTT_CLIENT_ID=estgoh-bancada07-r04
MQTT_KEEPALIVE=60
MQTT_OUTPUT_PATH=data/mqtt_received.jsonl
